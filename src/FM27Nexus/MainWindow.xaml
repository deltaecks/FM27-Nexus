<Window x:Class="FM27Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FM27Nexus.ViewModels"
        Title="FM27 Nexus"
        Height="640" Width="960"
        MinHeight="520" MinWidth="800"
        Background="#1B2430">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="#2E7D4F"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="FM27 Nexus" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Semibold"/>
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.85"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
      <Button Content="Refresh Installs" Command="{Binding RefreshInstallsCommand}"/>
      <Button Content="Browse Install…" Command="{Binding BrowseInstallCommand}"/>
      <Button Content="Attach to Live Game" Command="{Binding AttachAgentCommand}"/>
      <Button Content="Check for Updates" Command="{Binding CheckUpdatesCommand}"/>
      <Button Content="Apply Update" Command="{Binding ApplyUpdateCommand}"/>
      <Button Content="Repair Desktop Shortcut" Command="{Binding RepairShortcutCommand}"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,12">
        <TextBlock DockPanel.Dock="Top" Text="Detected installs" FontWeight="SemiBold"/>
        <ListBox ItemsSource="{Binding Installs}" Background="#243142" Foreground="#E8EEF5" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Opacity="0.7">
                  <Run Text="Exists:"/>
                  <Run Text="{Binding ExecutableExists, Mode=OneWay}"/>
                  <Run Text="  Version:"/>
                  <Run Text="{Binding VersionString}"/>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="Documents (OneDrive-safe)" FontWeight="SemiBold"/>
        <TextBox Text="{Binding DocumentsPath, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="True"
                 Background="#243142" Foreground="#E8EEF5" BorderThickness="0" Padding="8" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding DocumentsStatus}" Opacity="0.8" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Browse Documents…" Command="{Binding BrowseDocumentsCommand}"/>
          <Button Content="Use Default" Command="{Binding UseDefaultDocumentsCommand}" Background="#3A4A5C"/>
        </StackPanel>

        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Opacity="0.9"/>

        <TextBlock Text="Memory Agent" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <TextBlock Text="{Binding AgentStatus}" TextWrapping="Wrap" Opacity="0.9"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
