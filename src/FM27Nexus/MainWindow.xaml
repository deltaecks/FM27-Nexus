<Window x:Class="FM27Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FM27Nexus.ViewModels"
        Title="FM27 Nexus"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1024"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <TextBlock Text="{Binding FooterStatus}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Nav -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
            <TextBlock Text="FM27 Nexus" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Companion" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel>
            <RadioButton Content="Home" Style="{StaticResource NavButton}" IsChecked="{Binding IsHomePage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="Home" GroupName="nav"/>
            <RadioButton Content="My Club" Style="{StaticResource NavButton}" IsChecked="{Binding IsMyClubPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="MyClub" GroupName="nav"/>
            <RadioButton Content="Scouting" Style="{StaticResource NavButton}" IsChecked="{Binding IsScoutingPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="Scouting" GroupName="nav"/>
            <RadioButton Content="Tactics" Style="{StaticResource NavButton}" IsChecked="{Binding IsTacticsPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="Tactics" GroupName="nav"/>
            <RadioButton Content="Vault / Mods" Style="{StaticResource NavButton}" IsChecked="{Binding IsVaultPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="Vault" GroupName="nav"/>
            <RadioButton Content="Live" Style="{StaticResource NavButton}" IsChecked="{Binding IsLivePage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="Live" GroupName="nav"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Content -->
      <Grid Grid.Column="1" Margin="20">
        <!-- HOME -->
        <ScrollViewer Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Installs" Style="{StaticResource SectionTitle}"/>
                <ListBox ItemsSource="{Binding Installs}" Height="120">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding ExecutablePath, Mode=OneWay}" Foreground="#8B9BB0"/>
                      </TextBlock>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Refresh" Command="{Binding RefreshInstallsCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Browse Install…" Command="{Binding BrowseInstallCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Attach Agent (UAC)" Command="{Binding AttachAgentCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Documents" Style="{StaticResource SectionTitle}"/>
                <TextBox Text="{Binding DocumentsPath}" IsReadOnly="True"/>
                <TextBlock Text="{Binding DocumentsStatus}" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Browse…" Command="{Binding BrowseDocumentsCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Use Default" Command="{Binding UseDefaultDocumentsCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Load Latest Save" Command="{Binding LoadLatestSaveCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Check for Updates" Command="{Binding CheckUpdatesCommand}"/>
                  <Button Content="Apply Update" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Repair Shortcut" Command="{Binding RepairShortcutCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding AgentStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- MY CLUB -->
        <Grid Visibility="{Binding IsMyClubPage, Converter={StaticResource BoolToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="My Club" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Squad from your loaded save, plus live club details when connected." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding AvailableClubs}" SelectedItem="{Binding SelectedClubName}" Width="240"/>
              <Button Content="Refresh Live Club" Command="{Binding RefreshMyClubLiveCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Apply Field" Command="{Binding ApplyClubFieldCommand}"/>
            </StackPanel>
            <WrapPanel>
              <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding ClubSummary}" TextWrapping="Wrap"/></Border>
            </WrapPanel>
            <TextBlock Text="{Binding ClubLiveStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
          </StackPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" MaxHeight="200">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Live club fields" Style="{StaticResource SectionTitle}"/>
              <DataGrid ItemsSource="{Binding ClubFields}" SelectedItem="{Binding SelectedClubField}" IsReadOnly="False"
                        EnableRowVirtualization="True" AutoGenerateColumns="False" MaxHeight="150">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Field" Binding="{Binding Key}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Edit" Binding="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <DataGrid Grid.Row="2" ItemsSource="{Binding SquadView}" SelectedItem="{Binding SelectedPlayer}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Id" Binding="{Binding UniqueId}" Width="70"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="50"/>
              <DataGridTextColumn Header="CA" Binding="{Binding Ca}" Width="50"/>
              <DataGridTextColumn Header="PA" Binding="{Binding Pa}" Width="50"/>
              <DataGridTextColumn Header="RCA" Binding="{Binding RcaBest}" Width="60"/>
              <DataGridTextColumn Header="Role" Binding="{Binding RcaBestRole}" Width="80"/>
              <DataGridTextColumn Header="IP%" Binding="{Binding IpFitPct}" Width="55"/>
              <DataGridTextColumn Header="OOP%" Binding="{Binding OopFitPct}" Width="60"/>
              <DataGridTextColumn Header="Style%" Binding="{Binding StylePct}" Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- SCOUTING -->
        <DockPanel Visibility="{Binding IsScoutingPage, Converter={StaticResource BoolToVis}}">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Scouting" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding WorkspaceStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Load Latest Save" Command="{Binding LoadLatestSaveCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Open .fm…" Command="{Binding OpenFmSaveCommand}" Style="{StaticResource GhostButton}"/>
              <Button Content="Import Table" Command="{Binding ImportTableCommand}" Style="{StaticResource GhostButton}"/>
              <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource GhostButton}"/>
              <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource GhostButton}"/>
              <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter name/club/role"/>
            </StackPanel>
          </StackPanel>
          <DataGrid ItemsSource="{Binding PlayersView}" SelectedItem="{Binding SelectedPlayer}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Id" Binding="{Binding UniqueId}" Width="70"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="50"/>
              <DataGridTextColumn Header="Club" Binding="{Binding ClubName}" Width="140"/>
              <DataGridTextColumn Header="CA" Binding="{Binding Ca}" Width="50"/>
              <DataGridTextColumn Header="PA" Binding="{Binding Pa}" Width="50"/>
              <DataGridTextColumn Header="RCA" Binding="{Binding RcaBest}" Width="60"/>
              <DataGridTextColumn Header="Role" Binding="{Binding RcaBestRole}" Width="60"/>
              <DataGridTextColumn Header="G/90" Binding="{Binding GoalsPer90}" Width="55"/>
              <DataGridTextColumn Header="A/90" Binding="{Binding AssistsPer90}" Width="55"/>
              <DataGridTextColumn Header="IP%" Binding="{Binding IpFitPct}" Width="55"/>
              <DataGridTextColumn Header="OOP%" Binding="{Binding OopFitPct}" Width="60"/>
              <DataGridTextColumn Header="Style%" Binding="{Binding StylePct}" Width="60"/>
              <DataGridTextColumn Header="Status" Binding="{Binding FieldStatus}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- TACTICS -->
        <ScrollViewer Visibility="{Binding IsTacticsPage, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Tactical Understanding" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Maximize writes only factors that exist in your imported OpenEditor definition. Unmapped factors are never guessed." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Refresh Mapping" Command="{Binding RefreshTacticalFactorsCommand}" Style="{StaticResource GhostButton}"/>
              <Button Content="Maximize Tactical Understanding" Command="{Binding MaximizeTacticalUnderstandingCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding TacticsStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Tactical areas" Style="{StaticResource SectionTitle}"/>
                  <ItemsControl ItemsSource="{Binding TacticalAreaFactors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,10">
                          <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                          <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,4" Margin="12,0,0,0"
                                  Background="{StaticResource SurfaceAltBrush}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                          </Border>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Tactical comprehension" Style="{StaticResource SectionTitle}"/>
                  <ItemsControl ItemsSource="{Binding TacticalComprehensionFactors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,10">
                          <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- VAULT -->
        <ScrollViewer Visibility="{Binding IsVaultPage, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Vault / Mods" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Save Vault" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Snapshot .fm" Command="{Binding SnapshotSaveCommand}"/>
                  <Button Content="Refresh" Command="{Binding RefreshVaultCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Restore Latest" Command="{Binding RestoreVaultEntryCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding VaultEntries}" Height="140">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="{Binding CreatedUtc, Mode=OneWay}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding SaveName, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Mods / Skins / AssetBundles" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Install Mod…" Command="{Binding InstallModCommand}"/>
                  <Button Content="Create VanillaState" Command="{Binding CreateVanillaStateCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Restore VanillaState" Command="{Binding RestoreVanillaStateCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding VanillaSnapshots}" Height="100">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="{Binding Id, Mode=OneWay}"/>
                        <Run Text=" — files="/>
                        <Run Text="{Binding FileCount, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- LIVE -->
        <ScrollViewer Visibility="{Binding IsLivePage, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Live Editor" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Writes into the open FM27 career via game_plugin.dll. Import a matching OpenEditor definition — Nexus does not ship GPL packs." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding LiveStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Import OpenEditor Def…" Command="{Binding ImportOpenEditorDefinitionCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Connect Live" Command="{Binding ConnectLiveCommand}"/>
              <Button Content="Attach Agent" Command="{Binding AttachAgentCommand}" Style="{StaticResource GhostButton}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Apply player field" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox Width="120" Text="{Binding EditorField}" ToolTip="CA, PA, Attr.Pace…"/>
                  <TextBox Width="80" Text="{Binding EditorValue}"/>
                  <TextBox Width="80" Text="{Binding EditorIndex}" ToolTip="Player Id fallback"/>
                  <Button Content="Apply to Live Save" Command="{Binding ApplyLiveEditCommand}"/>
                  <Button Content="Stage / Apply" Command="{Binding ApplyEditsCommand}" Style="{StaticResource DangerButton}"/>
                  <Button Content="Undo" Command="{Binding UndoEditCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding EditorLog}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Legacy AOB profile (optional)" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox Width="160" Text="{Binding BuildId}"/>
                  <TextBox Width="120" Text="{Binding Storefront}"/>
                  <Button Content="Load Profile" Command="{Binding LoadOffsetProfileCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Import Pack…" Command="{Binding ImportOffsetPackCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Attach Process" Command="{Binding AttachSelectedProcessCommand}" Style="{StaticResource GhostButton}"/>
                  <Button Content="Validate Sanity" Command="{Binding ValidateSanityCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding AgentStatus}" Style="{StaticResource MutedText}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
